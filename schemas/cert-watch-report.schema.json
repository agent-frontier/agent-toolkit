{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/agent-frontier/agent-toolkit/schemas/cert-watch-report.schema.json",
  "title": "cert-watch --report --json output",
  "description": "Schema for the single JSON object emitted by `cert-watch.sh --report --json`.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "log_dir",
    "jsonl_path",
    "generated_at",
    "total_events",
    "total_runs",
    "real_runs",
    "dry_runs",
    "date_range",
    "total_certs_inventoried",
    "by_status",
    "expiring_soon",
    "per_source",
    "most_recent_run",
    "data_quality",
    "idle_streaks"
  ],
  "properties": {
    "log_dir": {"type": "string"},
    "jsonl_path": {"type": "string"},
    "generated_at": {"type": "string"},
    "total_events": {"type": "integer", "minimum": 0},
    "total_runs": {"type": "integer", "minimum": 0},
    "real_runs": {"type": "integer", "minimum": 0},
    "dry_runs": {"type": "integer", "minimum": 0},
    "date_range": {
      "type": "object",
      "additionalProperties": true,
      "required": ["first", "last"],
      "properties": {
        "first": {"type": ["string", "null"]},
        "last": {"type": ["string", "null"]}
      }
    },
    "total_certs_inventoried": {"type": "integer", "minimum": 0},
    "by_status": {"$ref": "#/$defs/certStatusCounts"},
    "expiring_soon": {
      "type": "array",
      "items": {"$ref": "#/$defs/certRecord"}
    },
    "per_source": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["name", "runs", "items_total", "status_counts", "cert_status_counts"],
        "properties": {
          "name": {"type": "string", "enum": ["local_certs", "remote_certs"]},
          "runs": {"type": "integer", "minimum": 0},
          "items_total": {"type": "integer", "minimum": 0},
          "status_counts": {
            "type": "object",
            "additionalProperties": {"type": "integer", "minimum": 0},
            "properties": {
              "ok": {"type": "integer", "minimum": 0},
              "idle": {"type": "integer", "minimum": 0},
              "warn": {"type": "integer", "minimum": 0},
              "dry_run": {"type": "integer", "minimum": 0}
            }
          },
          "cert_status_counts": {"$ref": "#/$defs/certStatusCounts"}
        }
      }
    },
    "most_recent_run": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": true,
          "required": ["run_id", "finished", "aggregate_status", "total_certs_inventoried", "by_status", "dry_run"],
          "properties": {
            "run_id": {"type": "string"},
            "finished": {"type": "string"},
            "aggregate_status": {"type": "string", "enum": ["ok", "warn", "error"]},
            "total_certs_inventoried": {"type": "integer", "minimum": 0},
            "by_status": {"$ref": "#/$defs/certStatusCounts"},
            "dry_run": {"type": "integer", "enum": [0, 1]}
          }
        }
      ]
    },
    "data_quality": {
      "type": "object",
      "additionalProperties": true,
      "required": ["invalid_lines", "examples"],
      "properties": {
        "invalid_lines": {"type": "integer", "minimum": 0},
        "examples": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["line", "error"],
            "properties": {
              "line": {"type": "integer"},
              "error": {"type": "string"}
            }
          }
        }
      }
    },
    "idle_streaks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["section", "consecutive_idle_runs", "last_productive_run"],
        "properties": {
          "section": {"type": "string", "enum": ["local_certs", "remote_certs"]},
          "consecutive_idle_runs": {"type": "integer", "minimum": 0},
          "last_productive_run": {
            "oneOf": [
              {"type": "null"},
              {
                "type": "object",
                "additionalProperties": true,
                "required": ["run_id", "ts"],
                "properties": {
                  "run_id": {"type": "string"},
                  "ts": {"type": "string"}
                }
              }
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "certStatusCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "warn", "expiring", "expired"],
      "properties": {
        "ok": {"type": "integer", "minimum": 0},
        "warn": {"type": "integer", "minimum": 0},
        "expiring": {"type": "integer", "minimum": 0},
        "expired": {"type": "integer", "minimum": 0}
      }
    },
    "certRecord": {
      "type": "object",
      "additionalProperties": true,
      "required": ["subject_cn", "issuer_cn", "not_before", "not_after", "days_remaining", "sha256_fingerprint", "source", "status"],
      "properties": {
        "subject_cn": {"type": "string"},
        "issuer_cn": {"type": "string"},
        "not_before": {"type": "string"},
        "not_after": {"type": "string"},
        "days_remaining": {"type": "integer", "minimum": 0},
        "sha256_fingerprint": {"type": "string"},
        "source": {"type": "string"},
        "status": {"type": "string", "enum": ["ok", "warn", "expiring", "expired"]},
        "section": {"type": "string"},
        "seen_at": {"type": "string"}
      }
    }
  }
}
